@echo off
REM ============================================================================
REM TESTWB.BAT - build every entry of the staged workbench disk, in DOS,
REM headless. The automated half of "test it before packing": DISK\
REM SELFTEST.BAT (generated by packwb.ps1) walks each entry and calls its
REM MAKE.BAT, exactly as a student would, and writes SELFTEST.OK only if
REM the walk reached the end. The binaries it produced are then compared
REM against the repository's own builds from outside.
REM
REM The interactive half - the menu itself - has no headless substitute:
REM boot it with TOOLS\RUNWB.BAT and fly it.
REM ============================================================================
cd /d %~dp0..
if exist LOCAL.BAT call .\LOCAL.BAT
if "%DOSBOX%"=="" set DOSBOX=dosbox.exe
if not exist DISK\SELFTEST.BAT goto nostage
if exist DISK\SELFTEST.OK del DISK\SELFTEST.OK
"%DOSBOX%" -noautoexec -noconsole -c "config -set cycles=max" -c "mount c %CD%\DISK" -c "c:" -c "SELFTEST.BAT"
if not exist DISK\SELFTEST.OK goto failed
echo.
echo SELFTEST reached the end. Now compare what it built.
goto end
:failed
echo.
echo SELFTEST did not finish - boot the disk with TOOLS\RUNWB.BAT and look.
goto end
:nostage
echo Stage first:  powershell -ExecutionPolicy Bypass -File TOOLS\packwb.ps1
:end
