; TEST2.INF - thirty seconds, the first clip long enough to say anything
; about bitrate. Same settings as TEST1.INF on purpose: the point of a
; second scene is to find out how much the numbers depend on the material.
;
;   dotnet run --project TOOLS\Vid2Owv -c Release -- LAB\OWLFLY4\VIDEO\TEST2.INF

SOURCE     = src/test2.mp4
OUTPUT     = TEST2.OWV

WIDTH      = 640
HEIGHT     = 400
FPS        = 12
KEYEVERY   = 48
AUDIO      = 22050
; 16 for the Sound Blaster 16, which is what a CD-era machine has and what
; DOSBox emulates; 8 for anything older, and eight bits hiss - see below.
AUDIOBITS  = 16

DITHER     = bayer:bayer_scale=3
DENOISE    = hqdn3d=4:3:12:9
TOLERANCE  = 2
SEARCH     = 24
COPY       = on
COPYSEARCH = 4

; The compressor lifts quiet passages so that they can be heard over a
; television's own noise, and the limiter stops its makeup gain clipping.
; It mattered most at eight bits, where a quiet passage sat on the
; quantisation floor and hissed (measured: -49 dBFS after this chain, with
; or without dither - eight bits simply have no further down). At sixteen
; bits the floor is 48 dB lower and the chain is about loudness only. Set
; to "none" to hear the material raw, which is worth doing once.
AUDIOFILTER = highpass=f=50,acompressor=threshold=0.06:ratio=4:attack=5:release=200:makeup=2,alimiter=limit=0.97
