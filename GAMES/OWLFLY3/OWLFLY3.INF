.title  OWL FLY III - seven video systems, three detail levels
.what   The third generation: Hercules to VGA, FULL to wireframe LOW
.tier   GAME
.main   SRC\OWLFLY3.ASM
.needs  SRC INSTALL\SFX.DAT
.needs  INSTALL\CPCGA.DAT INSTALL\CPEGA.DAT INSTALL\CPHGC.DAT
.needs  INSTALL\CPSCGA.DAT INSTALL\CPSEGA.DAT INSTALL\CPSHGC.DAT
.build  FASM SRC\RESDAT.ASM INSTALL\CITY.DAT
.build  FASM SRC\SIDEDAT.ASM INSTALL\CPSIDE.DAT
.build  FASM SRC\OWLFLY3.ASM INSTALL\OWLFLY3.EXE
.run    OWLFLY3.EXE
.rundir INSTALL
.ignore res INSTALL\CITY.DAT INSTALL\CPSIDE.DAT INSTALL\ENGINE.RAW
.ignore PLAYHGC.BAT TESTCGA.BAT TESTEGA.BAT stderr.txt stdout.txt
.engine ENGINE\E_8086.INC ENGINE\E_MATH.INC ENGINE\E_TERR.INC ENGINE\E_SND.INC ENGINE\E_M3D.INC ENGINE\E_RAST.INC
