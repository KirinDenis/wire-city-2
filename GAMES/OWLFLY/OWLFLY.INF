.title  OWL FLY - the polygon combat sim
.what   The whole game in a 40 KB COM plus one resource file
.tier   GAME
.main   SRC\CITY.ASM
.needs  SRC\DATA.INC SRC\KEYB.INC SRC\VIDEO.INC SRC\M3D.INC SRC\RASTER.INC SRC\TERRAIN.INC
.needs  SRC\SCENE.INC SRC\WORLD.INC SRC\WORLD2.INC SRC\FLIGHT.INC SRC\HUD.INC SRC\PLANES.INC
.needs  SRC\SOUND.INC SRC\PALPNL.INC SRC\PANELIM.INC SRC\RESDAT.ASM INSTALL\ENGINE.RAW
.build  FASM SRC\RESDAT.ASM INSTALL\CITY.DAT
.build  FASM SRC\CITY.ASM INSTALL\FLYOWL.COM
.run    FLYOWL.COM
.rundir INSTALL
.ignore res SRC\PANELIMG.INC INSTALL\CITY.DAT
.engine ENGINE\E_8086.INC ENGINE\E_MATH.INC ENGINE\E_TERR.INC ENGINE\E_SND.INC ENGINE\E_M3D.INC ENGINE\E_RAST.INC
