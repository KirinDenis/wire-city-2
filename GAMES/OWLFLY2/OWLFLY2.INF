.title  OWL FLY II - the successor
.what   Five segments, net play, the NEWTON sky - the course at full scale
.tier   GAME
.main   SRC\CITY.ASM
.needs  SRC INSTALL\SFX.DAT
.build  FASM SRC\RESDAT.ASM INSTALL\CITY.DAT
.build  FASM SRC\SIDEDAT.ASM INSTALL\CPSIDE.DAT
.build  FASM SRC\CITY.ASM INSTALL\FLYOWL2.EXE
.run    FLYOWL2.EXE
.rundir INSTALL
.ignore res INSTALL\CITY.DAT INSTALL\CPSIDE.DAT INSTALL\ENGINE.RAW YOUTUBE.txt
.engine ENGINE\E_8086.INC ENGINE\E_MATH.INC ENGINE\E_TERR.INC ENGINE\E_SND.INC ENGINE\E_M3D.INC ENGINE\E_RAST.INC
